# ═══════════════════════════════════════════════════════════════════════════
# Internship tracker — variables for ~/docker/stacks/apps/.env
#
# Append these to the stack's existing .env. CONFIG_ROOT, TZ, APPS_NET and
# TRAEFIK_NET are already there and are reused as-is — do not redefine them.
#
# Marked REQUIRED or OPTIONAL. Everything REQUIRED must have a real value
# before `docker compose up -d`, or the container starts and then refuses to
# do the one thing you want it to do.
# ═══════════════════════════════════════════════════════════════════════════

# ── Routing ────────────────────────────────────────────────────────────────
# REQUIRED. The public hostname. Becomes the Traefik Host() rule, the only
# name the cert is issued for.
TRACKER_HOST=jobs.jmistry.com

# ── Database ───────────────────────────────────────────────────────────────
# REQUIRED. Used to initialise the Postgres container on FIRST BOOT ONLY.
# Changing the password later does not change the existing database — see
# docs/DEPLOYMENT.md before you try.
TRACKER_DB_USER=tracker
# HEX, not base64: this value is interpolated straight into
# postgresql://user:PASSWORD@tracker-db:5432/... and base64's `/` and `+`
# would break the URL (a `/` ends the authority). `openssl rand -hex 32`.
TRACKER_DB_PASSWORD=CHANGE_ME_openssl_rand_hex_32
TRACKER_DB_NAME=internship_tracker

# ── Auth ───────────────────────────────────────────────────────────────────
# Authelia authenticates via Traefik forward-auth. There is no OIDC client to
# register and nothing to add to Authelia's configuration.yml — the middleware
# label on the router does the work, and this app just reads the headers it
# results in.
#
# REQUIRED. The name of your existing Authelia forward-auth middleware, as
# Traefik knows it. Find it with:
#   docker inspect authelia | grep -o 'traefik.http.middlewares[^=]*'
# It is usually something like `authelia@docker`.
TRACKER_AUTH_MIDDLEWARE=authelia@docker
# REQUIRED. The one identity allowed in, matched (case-insensitively) against
# the `Remote-Email` header, or `Remote-User` if your middleware does not
# forward the address. Blank or unset admits NOBODY — it fails closed, so a
# missing value looks exactly like "my own account is being refused".
TRACKER_ALLOWED_USER=you@example.com
# OPTIONAL. Where the header's "Sign out" link points — Authelia owns the
# session, so this is its logout URL. Omit and no link is rendered.
# TRACKER_AUTH_LOGOUT_URL=https://auth.jmistry.com/logout

# ── Ingestion ──────────────────────────────────────────────────────────────
# REQUIRED. Contact address in the scraper's User-Agent, so a site owner who
# objects has somewhere to write.
TRACKER_USER_AGENT_CONTACT=you@example.com
# OPTIONAL. Cron schedules, in TZ. Defaults shown; omit to accept them.
# TRACKER_INGEST_CRON=0 6 * * *
# TRACKER_DIGEST_CRON=0 7 * * *
# TRACKER_CLOSING_SOON_CRON=0 8 * * *

# ── Scoring stage 2 ────────────────────────────────────────────────────────
# OPTIONAL. Anthropic key for the Claude pass. Unset = deterministic scoring
# only; cached assessments still apply and nothing errors.
# Cost at the current catalog: about $0.03 for a full first pass.
# TRACKER_ANTHROPIC_API_KEY=

# ── Alerts ─────────────────────────────────────────────────────────────────
# OPTIONAL. Unset = that channel reports itself "off" on /alerts and is
# skipped. Discord is the one that has actually been tested end to end.
# TRACKER_DISCORD_WEBHOOK_URL=
# TRACKER_SMTP_HOST=
# TRACKER_SMTP_PORT=587
# TRACKER_SMTP_USER=
# TRACKER_SMTP_PASS=
# TRACKER_SMTP_FROM=
# TRACKER_SMTP_TO=

# ── Backups ────────────────────────────────────────────────────────────────
# OPTIONAL. Defaults: a dump every 24h, pruned after 14 days, but never
# fewer than 7 kept regardless of age.
# TRACKER_BACKUP_INTERVAL_SECONDS=86400
# TRACKER_BACKUP_RETENTION_DAYS=14
# TRACKER_BACKUP_KEEP_MIN=7
