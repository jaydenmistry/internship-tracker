# ═══════════════════════════════════════════════════════════════════════════
# Internship tracker — environment
#
# Copy to `.env` and fill in. `.env*` is gitignored and `.dockerignore`d, so
# real values never reach git history or an image layer. Every secret below is
# delivered to the containers as an environment variable and nothing else.
#
# ── Reload semantics ──────────────────────────────────────────────────────
# Each variable is tagged [restart] or [hot-reloaded].
#
# In practice EVERY variable in this file is [restart]: a container's
# environment is fixed at creation, so changing one means recreating the
# container (`docker compose up -d`, or Redeploy in Dokploy). Some are read at
# process boot (the cron schedules, WORKER_PORT) and some on every run
# (LLM_MAX_*, RESCORE_MAX_AGE_HOURS) — the distinction does not matter, because
# neither can change under a running container.
#
# The two things that genuinely reload without a restart are deliberately NOT
# environment variables:
#
#   [hot-reloaded]  config/scoring.json — all scoring weights, keyword lists,
#                   company tiers, thresholds, and the whole `llm.*` block
#                   (model, temperature, max adjustment). Re-read and re-hashed
#                   on every scoring run, and bind-mounted into both the app and
#                   the worker, so an edit on the host takes effect on the next
#                   cycle. There is no LLM_MODEL or LLM_TEMPERATURE variable and
#                   there should never be one.
#
#   [hot-reloaded]  alert thresholds and per-channel toggles — one JSON row in
#                   the `Setting` table (key `alerts.thresholds`), editable from
#                   /alerts. The worker reads it per send. Only the SMTP and
#                   Discord *credentials* below are environment.
# ═══════════════════════════════════════════════════════════════════════════


# ── Deployment ─────────────────────────────────────────────────────────────
# Routing is NOT configured here. The tracker runs as four services appended
# to the host stack at ~/docker/stacks/apps/compose.yml, and that stack's own
# .env supplies the values — see deploy/env.tracker.example for the TRACKER_*
# variables to add, and docs/DEPLOYMENT.md for the whole procedure.
#
# compose maps the stack's TRACKER_* names onto the names below, which are
# what the application code actually reads. This file remains the reference
# for that, and is what you copy to `.env` for LOCAL development.
#
# [restart] Container timezone. This is what the cron schedules below mean —
# INGEST_CRON="0 6 * * *" is 06:00 in THIS zone, not UTC.
TZ="America/New_York"


# ── Database ───────────────────────────────────────────────────────────────
# [restart] Credentials the `postgres` container initialises itself with, on
# first boot only. Changing them later does NOT change the existing database;
# see docs/DEPLOYMENT.md before you try.
POSTGRES_USER="tracker"
POSTGRES_PASSWORD="CHANGE_ME_generate_a_long_random_password"
POSTGRES_DB="internship_tracker"
# [restart] How the app and worker connect. Host `tracker-db` is the compose
# service name in the host stack (NOT `postgres` — that name would collide on
# a shared network the day a second Postgres-backed app appears). Keep `?schema=public`: node-postgres ignores unknown connection
# parameters, so lib/db.ts reads that parameter and hands it to the adapter
# explicitly — drop it and a proxied Postgres can silently use another schema.
# Username/password/database must match the three values above.
DATABASE_URL="postgresql://tracker:CHANGE_ME_generate_a_long_random_password@tracker-db:5432/internship_tracker?schema=public"
# [restart] LOCAL DEVELOPMENT ONLY — shadow database for `prisma migrate dev`
# and `prisma migrate diff`. Leave unset in production; `migrate deploy` never
# uses it. With `npx prisma dev` running, this is its port-51215 instance.
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"


# ── Auth (Authelia forward-auth, single user) ──────────────────────────────
# This app has no login flow and no session of its own. Authelia authenticates
# the request as a Traefik middleware and forwards `Remote-Email` /
# `Remote-User`; the app reads those and checks them against ALLOWED_USER.
#
# THESE HEADERS ARE TRUSTED. That is only safe because nothing but Traefik can
# reach the container — see the network notes in deploy/compose.tracker.yml.
# Running this app on a shared network, or exposing its port, hands anyone who
# can reach it a valid login.
#
# [restart] REQUIRED. The one identity allowed in. Matched case-insensitively
# against Remote-Email, then Remote-User. Blank or unset admits NOBODY.
ALLOWED_USER="you@example.com"
# [restart] OPTIONAL. Authelia's logout URL, for the header link. Unset = no
# link rendered.
AUTH_LOGOUT_URL=""


# ── Ingestion worker ───────────────────────────────────────────────────────
# [restart] Cron schedule for the full ingest → score → detail → rescore cycle,
# in TZ. An invalid expression disables this one job and logs it, rather than
# killing the worker at boot.
INGEST_CRON="0 6 * * *"
# [restart] Port for the worker's internal HTTP endpoints (POST /refresh,
# GET /healthz). Never published and never given a Traefik label: /refresh is
# unauthenticated and starts a full cycle, so it must stay on the compose
# network, reachable only as http://worker:8081.
WORKER_PORT=8081
# [restart] Contact address embedded in the scraper's User-Agent, so a site
# owner who objects has somewhere to write.
USER_AGENT_CONTACT="you@example.com"
# [restart] Days to keep the gzipped raw fetch payloads stored on IngestRun
# rows. The rows themselves are never deleted — only the blobs are pruned.
RAW_RETENTION_DAYS=30
# [restart] Re-fetch a listing's posting page once its stored detail is older
# than this many days.
DETAIL_REFETCH_DAYS=14
# [restart] Cap on posting pages fetched per cycle. Fetching is rate-limited per
# host, so this is the main lever on how fast posting-text coverage builds.
DETAIL_MAX_PER_RUN=250


# ── Scoring ────────────────────────────────────────────────────────────────
# [restart] Overrides where the scoring config is read from. The default
# (<workdir>/config/scoring.json) is what compose bind-mounts, so normally
# leave this unset. Changing the PATH needs a restart; editing the FILE it
# points at does not — that file is [hot-reloaded], see the header.
SCORING_CONFIG_PATH=""
# [restart] Stage-2 Claude pass. Leave empty to run deterministic scoring only;
# already-cached assessments still apply. Results are cached forever by
# posting-text hash, so an unchanged listing is never re-billed.
ANTHROPIC_API_KEY=""
# [restart] Hard ceiling on Claude calls per cycle — the cost guard. An
# unparseable value falls back to this default rather than removing the cap.
LLM_MAX_CALLS_PER_RUN=200
# [restart] Ceiling on how many listings stage 2 will even consider per run,
# cache hits included; keeps the candidate query bounded as the catalog grows.
LLM_MAX_CANDIDATES_PER_RUN=2000
# [restart] Rescore anything not scored within this many hours even when the
# config hash is unchanged, so freshness decay and deadline urgency stay honest.
RESCORE_MAX_AGE_HOURS=20


# ── Alerts ─────────────────────────────────────────────────────────────────
# [restart] Cron for the daily digest, in TZ.
DIGEST_CRON="0 7 * * *"
# [restart] Cron for the closing-soon sweep, in TZ. HIGH_SCORE alerts have no
# schedule — they fire at the end of every ingestion cycle.
CLOSING_SOON_CRON="0 8 * * *"
# [restart] IANA zone for alert date arithmetic: the digest's one-per-day key,
# the closing-soon window, and rendered deadlines. Unset = the container's zone.
ALERT_TIMEZONE="America/New_York"
# [restart] Discord incoming webhook. This URL *is* the credential — anyone
# holding it can post to the channel. Empty disables the Discord channel.
DISCORD_WEBHOOK_URL=""
# [restart] SMTP host for email alerts. Empty disables the email channel
# entirely; the Discord channel is unaffected either way.
SMTP_HOST=""
# [restart] 587 = STARTTLS (the default), 465 = implicit TLS.
SMTP_PORT=587
# [restart] Forces the TLS mode the port would otherwise imply. Normally unset.
SMTP_SECURE=""
# [restart] SMTP username. Set together with SMTP_PASS or leave both empty —
# an unauthenticated local relay is valid, half a credential never is.
SMTP_USER=""
# [restart] SMTP password. A real secret.
SMTP_PASS=""
# [restart] Envelope sender for alert mail.
SMTP_FROM="internship-tracker@example.com"
# [restart] The single recipient alerts are delivered to.
SMTP_TO="you@example.com"


# ── Backups ────────────────────────────────────────────────────────────────
# See docs/DEPLOYMENT.md for where dumps land and how to restore one.
# [restart] Seconds between pg_dump runs. The first dump is taken as soon as the
# backup container starts, then every interval. 86400 = daily.
BACKUP_INTERVAL_SECONDS=86400
# [restart] Delete dumps older than this many days.
BACKUP_RETENTION_DAYS=14
# [restart] ...but always keep at least this many, however old, so a long
# outage can never prune the volume down to nothing.
BACKUP_KEEP_MIN=7
