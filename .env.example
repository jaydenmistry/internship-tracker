# ── Database ────────────────────────────────────────────────────────────────
# Postgres connection string. In compose this points at the postgres service.
# Name the schema explicitly: without it, a proxied local Postgres can leak a
# search_path from another connection and silently use the wrong schema.
DATABASE_URL="postgresql://tracker:CHANGE_ME@postgres:5432/internship_tracker?schema=public"
# Local development only: shadow DB for `prisma migrate dev/diff` (unset in prod).
# With `npx prisma dev` running locally, use its port-51215 instance:
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# ── Ingestion worker ────────────────────────────────────────────────────────
# Cron schedule for the daily ingestion run (worker container local time).
INGEST_CRON="0 6 * * *"
# Port for the worker's internal HTTP endpoint (refresh-now + health). Never
# exposed through Traefik — compose-internal only.
WORKER_PORT=8081
# Contact email embedded in the scraper User-Agent (be a good citizen).
USER_AGENT_CONTACT="you@example.com"
# Days to keep gzipped raw fetch payloads on IngestRun rows (rows are kept).
RAW_RETENTION_DAYS=30
# Stage-3 posting-detail fetch: re-fetch a listing's page after this many days…
DETAIL_REFETCH_DAYS=14
# …and fetch at most this many posting pages per run (rate-limited per host, so
# this is the main lever on how fast posting-text coverage builds up).
DETAIL_MAX_PER_RUN=250

# ── Scoring ─────────────────────────────────────────────────────────────────
# Weights/keywords/thresholds live in this file, NOT in env. Mount it as a
# volume so edits take effect on the next scoring run — no restart, no rebuild.
SCORING_CONFIG_PATH="./config/scoring.json"
# Stage 2 (optional Claude pass). Leave the key unset to run rule-scoring only;
# cached assessments still apply. Results are cached by posting-text hash, so
# unchanged listings never re-bill.
ANTHROPIC_API_KEY=""
# Hard cap on Claude calls per cycle — cost guard. A malformed value falls back
# to this default rather than disabling the cap.
LLM_MAX_CALLS_PER_RUN=200
# Ceiling on how many listings stage 2 will consider in one run (cache hits
# included); keeps the candidate query bounded as the catalog grows.
LLM_MAX_CANDIDATES_PER_RUN=2000
# Rescore anything not scored within this many hours even when the config is
# unchanged, so freshness decay and deadline urgency stay accurate.
RESCORE_MAX_AGE_HOURS=20

# ── Alerts ──────────────────────────────────────────────────────────────────
# Cron for the daily digest (worker container local time, like INGEST_CRON).
DIGEST_CRON="0 7 * * *"
# Cron for the closing-soon sweep. High-score alerts have no schedule of their
# own — they fire at the end of every ingestion cycle.
CLOSING_SOON_CRON="0 8 * * *"
# IANA zone for alert date arithmetic (the digest's one-per-day key, the
# closing-soon window, rendered deadlines). Unset = the container's own zone.
ALERT_TIMEZONE="America/New_York"
# Discord incoming webhook. This URL IS the credential — anyone holding it can
# post to the channel. Leave empty to turn the Discord channel off entirely.
DISCORD_WEBHOOK_URL=""
# SMTP for email alerts. Leave SMTP_HOST empty to turn the email channel off.
SMTP_HOST=""
# 587 = STARTTLS (default), 465 = implicit TLS.
SMTP_PORT=587
# Override the TLS mode the port implies; normally leave this unset.
SMTP_SECURE=""
# Credentials. Set both or neither — an unauthenticated local relay is valid.
SMTP_USER=""
SMTP_PASS=""
# Envelope sender, and the single recipient the alerts go to.
SMTP_FROM="internship-tracker@example.com"
SMTP_TO="you@example.com"
