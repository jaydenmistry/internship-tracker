  "disqualifiers": {
    "advancedDegrees": {
      "reasonPrefix": "requires",
      "bachelorsExempt": true,
      "bachelorsExemptNote": "Sources list degrees[] as the set of ACCEPTED degrees (Simplify emits [\"Bachelor's\",\"Master's\",\"MBA\",\"PhD\"] for a role open to undergrads). When a bachelor-level entry is present the posting accepts undergrads, so it is NOT disqualified.",
      "bachelorPatterns": ["\\bbachelor'?s?\\b", "\\bb\\.?s\\.?\\b", "\\bb\\.?a\\.?\\b", "\\bundergraduate\\b"],
      "degrees": [
        { "id": "masters", "reason": "requires Master's degree", "patterns": ["\\bmaster'?s?\\b", "\\bm\\.?s\\.?\\b", "\\bm\\.?sc\\.?\\b", "\\bm\\.?eng\\.?\\b"] },
        { "id": "phd", "reason": "requires PhD", "patterns": ["\\bph\\.?\\s?d\\.?\\b", "\\bdoctoral\\b", "\\bdoctorate\\b"] },
        { "id": "mba", "reason": "requires MBA", "patterns": ["\\bm\\.?b\\.?a\\.?\\b"] },
        { "id": "jd", "reason": "requires JD", "patterns": ["\\bj\\.?d\\.?\\b", "\\bjuris\\s+doctor\\b"] },
        { "id": "md", "reason": "requires MD", "patterns": ["\\bm\\.?d\\.?\\b"] },
        { "id": "dds", "reason": "requires DDS", "patterns": ["\\bd\\.?d\\.?s\\.?\\b", "\\bd\\.?m\\.?d\\.?\\b"] },
        { "id": "do", "reason": "requires DO", "patterns": ["\\bd\\.?o\\.?\\b"] },
        { "id": "dvm", "reason": "requires DVM", "patterns": ["\\bd\\.?v\\.?m\\.?\\b"] },
        { "id": "pharmd", "reason": "requires PharmD", "patterns": ["\\bpharm\\.?\\s?d\\.?\\b"] }
      ],
      "textPatterns": [
        { "pattern": "master'?s?(?:\\s+degree)?\\s+(?:is\\s+)?required", "reason": "requires Master's degree" },
        { "pattern": "ph\\.?\\s?d\\.?(?:\\s+degree)?\\s+(?:is\\s+)?required", "reason": "requires PhD" },
        { "pattern": "mba(?:\\s+degree)?\\s+(?:is\\s+)?required", "reason": "requires MBA" },
        { "pattern": "graduate\\s+degree\\s+(?:is\\s+)?required", "reason": "requires a graduate degree" },
        { "pattern": "requires?\\s+(?:a\\s+|an\\s+)?(?:master'?s?|ph\\.?\\s?d\\.?|mba)(?:\\s+degree)?", "reason": "requires an advanced degree" },
        { "pattern": "currently\\s+pursuing\\s+(?:a\\s+|an\\s+)?(?:master'?s?|ph\\.?\\s?d\\.?|mba|graduate\\s+degree)", "reason": "for students pursuing an advanced degree" },
        { "pattern": "must\\s+be\\s+(?:currently\\s+)?(?:enrolled\\s+in|pursuing)\\s+(?:a\\s+|an\\s+)?(?:master'?s?|ph\\.?\\s?d\\.?|graduate)", "reason": "for students pursuing an advanced degree" },
        { "pattern": "(?:master'?s?|ph\\.?\\s?d\\.?)\\s+(?:students?|candidates?)\\s+only", "reason": "advanced-degree students only" },
        { "pattern": "open\\s+(?:only\\s+)?to\\s+(?:master'?s?|ph\\.?\\s?d\\.?|graduate)\\s+students?", "reason": "advanced-degree students only" }
      ],
      "textExemptPatterns": [
        "bachelor'?s?[^.]{0,80}\\bor\\b[^.]{0,40}(?:master'?s?|ph\\.?\\s?d\\.?)",
        "(?:master'?s?|ph\\.?\\s?d\\.?)[^.]{0,80}\\bor\\b[^.]{0,40}bachelor'?s?",
        "bachelor'?s?[^.]{0,40}[,/]\\s*(?:master'?s?|ph\\.?\\s?d\\.?)",
        "(?:bachelor'?s?|undergraduate)[^.]{0,60}\\b(?:and|or)\\s+(?:above|higher)\\b"
      ]
    },
    "workAuthorization": {
      "reason": "Canada/UK/EU work authorization",
      "remoteExempt": true,
      "blockedCountries": [
        "CA", "UK", "DE", "FR", "IE", "NL", "ES", "IT", "PL", "SE",
        "DK", "FI", "NO", "PT", "BE", "AT", "CH", "CZ", "RO", "HU"
      ]
    },
    "closed": {
      "reason": "posting likely closed"
    }
  },
  "thresholds": {
    "_comment": "detailFetchMin is measured on gateScore (techFit excluded from the denominator), NOT on the displayed score. Raise it if fetch volume becomes a problem; lower it to cover more of the catalog. llmMin is measured on ruleScore.",
    "detailFetchMin": 50,
    "llmMin": 70
  },
  "llm": {
    "enabled": true,
    "model": "claude-haiku-4-5",
    "maxAdjustment": 15,
    "maxPostingTextChars": 6000,
    "maxRationaleChars": 300,
    "maxTokens": 512,
    "_temperature": "0 keeps stage 2 reproducible: an assessment is cached forever against the posting-text hash, so the first roll is the score the listing keeps. At the API default, four identical calls on one posting spread 10 points on a ±15 scale.",
    "temperature": 0
  }
}
